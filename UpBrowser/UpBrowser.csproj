<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<PublishAot>true</PublishAot>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
		<!-- 启用动态代码支持，让 Jurassic 等通过 Assembly.LoadFrom 加载的引擎可以正常工作 -->
		<IlcDynamicCodeSupportNeeded>true</IlcDynamicCodeSupportNeeded>
	</PropertyGroup>

 	<PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
  		<SupportedOSPlatformVersion>5.1</SupportedOSPlatformVersion>
 		<SupportWinXP>true</SupportWinXP>
  	</PropertyGroup>

 	

 	<ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
 		<PackageReference Include="YY-Thunks" Version="1.2.2" />
		<PackageReference Include="VC-LTL" Version="5.3.1" />
 	</ItemGroup>

	<ItemGroup>
		<TrimmerRootDescriptor Include="$(MSBuildThisFileDirectory)ILLink.Descriptors.xml" />
		<TrimmerRootAssembly Include="UpBrowser.Core" />
		<TrimmerRootAssembly Include="UpBrowser.Rendering" />
	</ItemGroup>

	<!-- Single-process mode: root Jint so its reflection-based CLR interop survives AOT trimming -->
	<ItemGroup Condition="'$(UseMultipleJsEngine)' != 'true'">
		<TrimmerRootAssembly Include="Jint" />
	</ItemGroup>
	<PropertyGroup Condition="'$(UseMultipleJsEngine)' != 'true'">
		<NoWarn>$(NoWarn);IL2026;IL2111</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\UpBrowser.Rendering\UpBrowser.Rendering.csproj" />
		<ProjectReference Include="..\UpBrowser.Core\UpBrowser.Core.csproj" />
		<ProjectReference Include="..\UpBrowser.Input\UpBrowser.Input.csproj" />
		<ProjectReference Include="..\UpBrowser.PageContract\UpBrowser.PageContract.csproj" />
		<ProjectReference Include="..\UpBrowser.PageHost\UpBrowser.PageHost.csproj" />
		<!-- JsEngineHost 以独立进程运行，不作为程序集引用，也不加 ProjectReference（避免 AOT/SelfContained 冲突） -->
	</ItemGroup>

	<!-- 构建时确保 JsEngineHost 已编译，并复制到输出目录（仅多进程模式） -->
	<Target Name="EnsureJsEngineHostBuilt" BeforeTargets="CopyJsEngineHostOutput" Condition="'$(UseMultipleJsEngine)' == 'true'">
		<PropertyGroup>
			<JsEngineHostTFM Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</JsEngineHostTFM>
			<JsEngineHostTFM Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</JsEngineHostTFM>
			<JsEngineHostOutDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0-windows\</JsEngineHostOutDir>
			<JsEngineHostOutDir Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0\</JsEngineHostOutDir>
		</PropertyGroup>
		<Exec Command="dotnet restore &quot;$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj'))&quot; -p:UseMultipleJsEngine=true" />
		<!--
		  Plain build with an explicit framework-dependent override: the host
		  csproj defaults to SelfContained=true, which silently pushes its output
		  into a self-contained RID subfolder (win-x64\) whose runtimeconfig has
		  no framework reference. Copying THAT into the app directory hijacked
		  the apphost's runtime resolution and broke startup. Building with
		  SelfContained=false keeps the flat TFM folder as the single output
		  location, framework-dependent like the installed shared runtime.
		-->
		<Exec Command="dotnet build &quot;$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj'))&quot; -c $(Configuration) -f $(JsEngineHostTFM) -p:SelfContained=false -p:UseMultipleJsEngine=true" />
	</Target>

	<Target Name="CopyJsEngineHostOutput" AfterTargets="Build" DependsOnTargets="EnsureJsEngineHostBuilt" Condition="'$(UseMultipleJsEngine)' == 'true'">
		<PropertyGroup>
			<JsEngineHostOutDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0-windows\</JsEngineHostOutDir>
			<JsEngineHostOutDir Condition="!$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)..\UpBrowser.JsEngineHost\bin\$(Configuration)\net10.0\</JsEngineHostOutDir>
		</PropertyGroup>
		<ItemGroup>
			<JsEngineHostFiles Include="$(JsEngineHostOutDir)UpBrowser.JsEngineHost.*" />
			<JsEngineHostFiles Include="$(JsEngineHostOutDir)*.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(JsEngineHostFiles)" DestinationFolder="$(TargetDir)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="true" />
		<Message Text="Copied @(JsEngineHostFiles->Count()) JsEngineHost files from $(JsEngineHostOutDir) to $(TargetDir)" Importance="high" />
	</Target>

	<!-- 发布时自动编译 JsEngineHost 并复制到输出目录（仅多进程模式） -->
	<Target Name="PublishJsEngineHost" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != '' and '$(UseMultipleJsEngine)' == 'true'">
		<Exec Command="dotnet publish &quot;$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..\UpBrowser.JsEngineHost\UpBrowser.JsEngineHost.csproj'))&quot; -c $(Configuration) -r $(RuntimeIdentifier) -p:UseMultipleJsEngine=true -o &quot;$(PublishDir)&quot;" />
		<Message Text="JsEngineHost published to $(PublishDir)" Importance="high" />
	</Target>

	<!-- V8 native DLL is downloaded on-demand via JsEngineDownloader -->

	<!--
	  RID-aware local SkiaSharp native library copy.
	  When UseLocalSkiaSharp=true, the vendored SkiaSharp native asset copy is not RID-aware
	  for win-x86/win-x64, so copy the correct-arch libSkiaSharp.dll from the local native output
	  after Build/Publish (and after the JsEngineHost publish) to guarantee the final output
	  matches the target RuntimeIdentifier.
	-->
	<Target Name="CopyLocalSkiaSharpNative"
	        AfterTargets="Build;Publish;PublishJsEngineHost"
	        Condition="'$(UseLocalSkiaSharp)' == 'true' and ($([MSBuild]::IsOSPlatform('Windows')) or '$(RuntimeIdentifier)' == 'win-x86' or '$(RuntimeIdentifier)' == 'win-x64' or '$(RuntimeIdentifier)' == 'win-arm64' or '$(RuntimeIdentifier)' == 'win10-x86' or '$(RuntimeIdentifier)' == 'win10-x64' or '$(RuntimeIdentifier)' == 'win10-arm64')">
		<PropertyGroup>
			<_LocalSkiaArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</_LocalSkiaArch>
			<_LocalSkiaArch Condition="'$(RuntimeIdentifier)' == 'win-x64'">x64</_LocalSkiaArch>
			<_LocalSkiaArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</_LocalSkiaArch>
			<_LocalSkiaArch Condition="'$(RuntimeIdentifier)' == 'win10-x86'">x86</_LocalSkiaArch>
			<_LocalSkiaArch Condition="'$(RuntimeIdentifier)' == 'win10-x64'">x64</_LocalSkiaArch>
			<_LocalSkiaArch Condition="'$(RuntimeIdentifier)' == 'win10-arm64'">arm64</_LocalSkiaArch>
			<_LocalSkiaArch Condition="'$(_LocalSkiaArch)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_LocalSkiaArch>
			<_LocalSkiaSource Condition="Exists('..\third_party\SkiaSharp\output\native\windows\$(_LocalSkiaArch)\libSkiaSharp.dll')">..\third_party\SkiaSharp\output\native\windows\$(_LocalSkiaArch)\libSkiaSharp.dll</_LocalSkiaSource>
		</PropertyGroup>
		<Copy SourceFiles="$(_LocalSkiaSource)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
		      Condition="'$(_LocalSkiaSource)' != '' and '$(TargetDir)' != ''" />
		<Copy SourceFiles="$(_LocalSkiaSource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false"
		      Condition="'$(_LocalSkiaSource)' != '' and '$(PublishDir)' != ''" />
	</Target>
</Project>
